<Page x:Class="курсач.Ruler"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсач"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Ruler" KeyDown="Backwar">

    <Grid x:Name="RuleRPage">
        <Grid.Background>
            <ImageBrush ImageSource="/RulesParchment.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Управление" Grid.ColumnSpan="3" Grid.RowSpan="1" TextAlignment="Center" FontSize="55" FontFamily="{StaticResource MinecraftFont}" Foreground="#382217"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="Правила" Grid.ColumnSpan="3" Grid.RowSpan="1" TextAlignment="Center" FontSize="55" FontFamily="{StaticResource MinecraftFont}" Foreground="#382217"></TextBlock>
        <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="5" TextBlock.Foreground="#382217" TextBlock.FontFamily="{StaticResource MinecraftFont}" TextBlock.FontSize="32" Margin="50 0 0 0">
            <TextBlock Text="W - ВВЕРХ" Margin="0 0 0 10"/>
            <TextBlock Text="A - ВЛЕВО" Margin="0 0 0 10" />
            <TextBlock Text="S - ВНИЗ" Margin="0 0 0 10" />
            <TextBlock Text="D - ВПРАВО" Margin="0 0 0 0" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" Grid.RowSpan="5" TextBlock.Foreground="#382217" TextBlock.FontFamily="{StaticResource MinecraftFont}" TextBlock.FontSize="22" TextBlock.TextAlignment="Center" Margin="0 0 30 0">
            <TextBlock Text="НА КАРТЕ ГЕНЕРИРУЮТСЯ РАНДОМНО МИНЫ," Margin="0 0 0 15"/>
            <TextBlock Text="ЗАТЕМ, СПУСТЯ 3 СЕКУНДЫ, ИСЧЕЗАЮТ" Margin="0 0 0 15" />
            <TextBlock Text="ВАША ЗАДАЧА ПРОЙТИ ОТ ОДНОГО КОНЦА ПОЛЯ" Margin="0 0 0 15" />
            <TextBlock Text="ДО ДРУГОГО НЕ ЗАДЕВ ПРОПАВШИЕ МИНЫ" Margin="0 0 0 0" />
        </StackPanel>

        <Button x:Name="GoBack" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" KeyDown="Backwar" Content="Назад" Width="200" Height="60" FontFamily="{StaticResource MinecraftFont}" Foreground="#382217" FontSize="40" Background="Transparent"  MouseEnter="RuleEnter" MouseLeave="GoBack_MouseLeave" BorderBrush="Transparent" Click="goback">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Page>
