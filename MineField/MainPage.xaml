<Page x:Class="курсач.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсач"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Main">

    <Grid x:Name="MainWin">
        <Grid.Background>
            <ImageBrush ImageSource="/SummerMeadow.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="textBlock" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="Минное поле" FontSize="72" TextAlignment="Center" FontFamily="{StaticResource MinecraftFont}" Foreground="White"/>
        <Button x:Name="Play" Grid.Column="2" Grid.Row="1" Width="220" Height="60" Content="Играть"  FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="38" Background="Transparent"  MouseEnter="ExitEnter" MouseLeave="ExitLeave" BorderBrush="Transparent" Click="PlayGame">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="Rules" Grid.Row="2" Grid.Column="2" Width="220" Height="60" Content="Правила" FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="38" Background="Transparent"  MouseEnter="ExitEnter" MouseLeave="ExitLeave" BorderBrush="Transparent" Click="Click_Rules">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="Lider" Grid.Row="3" Grid.Column="2" Width="220" Height="60" Content="Лидеры" FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="38" Background="Transparent"  MouseEnter="ExitEnter" MouseLeave="ExitLeave" BorderBrush="Transparent" Click="LoadLeaders">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="Player" Grid.Row="4" Grid.Column="2" Width="220" Height="60" Content="Игрок" FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="38" Background="Transparent"  MouseEnter="ExitEnter" MouseLeave="ExitLeave" BorderBrush="Transparent" Click="LetsChangeName">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="Exit" Grid.Row="5" Grid.Column="2" Width="220" Height="60" Content="Выйти" FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="38" Background="Transparent"  MouseEnter="ExitEnter" MouseLeave="ExitLeave" BorderBrush="Transparent" Click="Exite">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <Canvas x:Name="Main" Height="720" Width="1280" Focusable="True"></Canvas>
    </Grid>
</Page>
