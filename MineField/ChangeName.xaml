<Page x:Class="курсач.ChangeName"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсач"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="ChangeName">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/BackgroundChangeName.png"></ImageBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Info" Focusable="True" Text="Введите ваше будущее имя" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center" KeyDown="Goback"></TextBlock>
        <TextBlock x:Name="Info2" Text="Максимум в нике 10 символов! :)" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="23" VerticalAlignment="Bottom" HorizontalAlignment="Center"></TextBlock>
        <TextBlock x:Name="Changed" Text="Имя успешно изменено на " Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" FontFamily="{StaticResource MinecraftFont}" Foreground="White" FontSize="15" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"></TextBlock>
        <TextBox x:Name="WriteName" Focusable="True" Text="Ваше имя" FontSize="32" FontFamily="{StaticResource MinecraftFont}" Foreground="LightGray" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Width="500" Height="80" GotFocus="ClearText" PreviewTextInput="Capybara" PreviewKeyDown="NoSpace" TextChanged="ShortNick"/>
    </Grid>
</Page>
