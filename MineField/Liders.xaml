<Page x:Class="курсач.Liders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсач"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Liders">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/backleader.png"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image Source="/leaderboard.png" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="5"/>
        <TextBlock x:Name="Leaders" Text="Пока что лидеров нет((" Focusable="True" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="3" FontFamily="ascii" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 60 0 0"></TextBlock>
        <Button x:Name="Lider" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Width="220" Height="60" Content="Назад" FontFamily="ascii" Foreground="White" FontSize="38" VerticalAlignment="Bottom" Background="Transparent"  MouseEnter="EnterM" MouseLeave="ExitM" BorderBrush="Transparent" Click="GoBAqak">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Page>
